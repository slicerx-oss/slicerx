{
  "name": "@slicerx/desktop",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "tauri:config": "node ../../packages/edition-config/src/cli.ts tauri ../../editions/slicerx/edition.config.ts desktop src-tauri/gen/edition.conf.json",
    "build:app": "pnpm tauri:config && tauri build --config src-tauri/gen/edition.conf.json"
  },
  "dependencies": {
    "@slicerx/app": "workspace:*",
    "@slicerx/brand-icons": "workspace:*",
    "@slicerx/cloud": "workspace:*",
    "@slicerx/connect": "workspace:*",
    "@slicerx/contracts": "workspace:*",
    "@slicerx/edition-config": "workspace:*",
    "@slicerx/link-client": "workspace:*",
    "@slicerx/settings": "workspace:*",
    "@slicerx/slicer": "workspace:*",
    "@slicerx/ui": "workspace:*",
    "@slicerx/web": "workspace:*",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-opener": "2.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
