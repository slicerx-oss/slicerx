{
 "comment": "The first layer line width, elephant foot compensation and brim gap of the maker's Input Shaper print presets, written over the stock Prusa MK4 and MINI, whose resolved presets carry the generic values (120% first layer lines, no compensation). Every nozzle and tier: 0.32 mm lines, no compensation and no brim gap on the 0.25 mm nozzle, 0.5, 0.68 and 1 mm lines with 0.2 mm compensation on the 0.4, 0.6 and 0.8 mm nozzles, as the MK4S, XL and CORE One presets already have. Applied last to resolved/prusa.json by packages/settings/scripts/apply-overlay.ts, which gen-resolved.ts also runs. Values are in the profiles' own format, by printer model, nozzle size and quality tier.",
 "source": {
  "process": "Prusa stock print presets for the MK4 Input Shaper and MINI & MINI+ Input Shaper, every nozzle"
 },
 "filament": {},
 "machine": {},
 "process": {
  "prusa-mk4": {
   "0.25": {
    "standard": {
     "preset": "0.12mm SPEED @MK4IS 0.25",
     "values": {
      "initial_layer_line_width": "0.32",
      "brim_object_gap": "0"
     }
    }
   },
   "0.4": {
    "standard": {
     "preset": "0.20mm SPEED @MK4IS 0.4",
     "values": {
      "initial_layer_line_width": "0.5",
      "elefant_foot_compensation": "0.2"
     }
    },
    "draft": {
     "preset": "0.20mm STRUCTURAL @MK4IS 0.4",
     "values": {
      "initial_layer_line_width": "0.5",
      "elefant_foot_compensation": "0.2"
     }
    },
    "fine": {
     "preset": "0.15mm SPEED @MK4IS 0.4",
     "values": {
      "initial_layer_line_width": "0.5",
      "elefant_foot_compensation": "0.2"
     }
    },
    "extra_fine": {
     "preset": "0.10mm FAST DETAIL @MK4IS 0.4",
     "values": {
      "initial_layer_line_width": "0.5",
      "elefant_foot_compensation": "0.2"
     }
    }
   },
   "0.6": {
    "standard": {
     "preset": "0.25mm SPEED @MK4IS 0.6",
     "values": {
      "initial_layer_line_width": "0.68",
      "elefant_foot_compensation": "0.2"
     }
    }
   },
   "0.8": {
    "standard": {
     "preset": "0.40mm QUALITY @MK4IS 0.8",
     "values": {
      "initial_layer_line_width": "1",
      "elefant_foot_compensation": "0.2"
     }
    }
   }
  },
  "prusa-mini-plus": {
   "0.25": {
    "standard": {
     "preset": "0.12mm SPEED @MINIIS 0.25",
     "values": {
      "initial_layer_line_width": "0.32",
      "brim_object_gap": "0"
     }
    }
   },
   "0.4": {
    "standard": {
     "preset": "0.20mm SPEED @MINIIS 0.4",
     "values": {
      "initial_layer_line_width": "0.5",
      "elefant_foot_compensation": "0.2"
     }
    },
    "draft": {
     "preset": "0.20mm STRUCTURAL @MINIIS 0.4",
     "values": {
      "initial_layer_line_width": "0.5",
      "elefant_foot_compensation": "0.2"
     }
    },
    "fine": {
     "preset": "0.15mm SPEED @MINIIS 0.4",
     "values": {
      "initial_layer_line_width": "0.5",
      "elefant_foot_compensation": "0.2"
     }
    },
    "extra_fine": {
     "preset": "0.10mm FAST DETAIL @MINIIS 0.4",
     "values": {
      "initial_layer_line_width": "0.5",
      "elefant_foot_compensation": "0.2"
     }
    }
   },
   "0.6": {
    "standard": {
     "preset": "0.25mm SPEED @MINIIS 0.6",
     "values": {
      "initial_layer_line_width": "0.68",
      "elefant_foot_compensation": "0.2"
     }
    }
   },
   "0.8": {
    "standard": {
     "preset": "0.40mm QUALITY @MINIIS 0.8",
     "values": {
      "initial_layer_line_width": "1",
      "elefant_foot_compensation": "0.2"
     }
    }
   }
  }
 }
