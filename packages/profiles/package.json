    "./filaments/*": "./filaments/*",
    "./resolved/*": "./resolved/*",
    "./cura/*": "./cura/*",
    "./printer-images/*": "./printer-images/*"
  },
  "files": ["gcode.json", "machine.json", "process-speeds.json", "filaments", "resolved", "cura", "printer-images", "LICENSE", "README.md"],
