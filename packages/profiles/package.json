{
  "name": "@slicerx/profiles",
  "version": "0.1.0",
  "private": true,
  "description": "Stock printer, filament and process profile data for SlicerX, from the makers' profiles as OrcaSlicer resolves them.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./gcode.json": "./gcode.json",
    "./machine.json": "./machine.json",
