[
  {
    "id": "bambu-lan",
    "name": "Bambu Lab LAN",
    "version": "0.1.0",
    "kind": "printer",
    "protocols": [
      "mqtt-tls",
      "ftps",
      "ssdp"
    ],
    "capabilities": [
      "status",
      "events",
      "upload",
      "start",
      "pause",
      "resume",
      "cancel",
      "camera",
      "filament_slots",
      "gcode_console"
    ],
    "tools": [
      {
        "name": "bambu-lan.status",
        "description": "Read the normalized status of one printer.",
        "permission": "read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "printerId": {
              "type": "string",
              "description": "Printer id, such as bay-1"
            }
          },
          "required": [
            "printerId"
          ]
        }
      },
      {
        "name": "bambu-lan.queue",
        "description": "Upload a sliced file to the printer without starting it.",
        "permission": "queue",
        "inputSchema": {
          "type": "object",
          "properties": {
            "printerId": {
              "type": "string",
              "description": "Printer id, such as bay-1"
            },
            "file": {
              "type": "string",
              "description": "Project file id"
            }
          },
          "required": [
            "printerId",
            "file"
          ]
        }
      },
      {
        "name": "bambu-lan.start",
        "description": "Start an uploaded file. Heats the printer.",
        "permission": "start",
        "inputSchema": {
          "type": "object",
          "properties": {
            "printerId": {
              "type": "string",
              "description": "Printer id, such as bay-1"
            },
            "path": {
              "type": "string"
            },
            "plate": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "printerId",
            "path"
          ]
        }
      },
      {
        "name": "bambu-lan.pause",
        "description": "Pause the running job.",
        "permission": "start",
        "inputSchema": {
          "type": "object",
          "properties": {
            "printerId": {
              "type": "string",
              "description": "Printer id, such as bay-1"
            }
          },
          "required": [
            "printerId"
          ]
        }
      },
      {
        "name": "bambu-lan.resume",
        "description": "Resume a paused job.",
        "permission": "start",
        "inputSchema": {
          "type": "object",
          "properties": {
            "printerId": {
              "type": "string",
              "description": "Printer id, such as bay-1"
            }
          },
          "required": [
            "printerId"
          ]
        }
      },
      {
        "name": "bambu-lan.cancel",
        "description": "Cancel the running job.",
        "permission": "start",
        "inputSchema": {
          "type": "object",
          "properties": {
            "printerId": {
              "type": "string",
              "description": "Printer id, such as bay-1"
            }
          },
          "required": [
            "printerId"
          ]
        }
      },
      {
        "name": "bambu-lan.gcode",
        "description": "Send one G-code line to the printer.",
        "permission": "start",
        "inputSchema": {
          "type": "object",
          "properties": {
            "printerId": {
              "type": "string",
              "description": "Printer id, such as bay-1"
            },
            "line": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "printerId",
            "line"
          ]
        }
      }
    ],
    "network": [
      "lan:8883",
      "lan:990",
      "lan:6000",
      "lan:322",
      "lan:1990",
      "lan:2021"
    ]
  },
