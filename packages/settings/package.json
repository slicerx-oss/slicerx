{
  "name": "@slicerx/settings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./js/index.ts",
    "./easy-map.json": "./easy-map.json",
    "./schema.json": "./schema.json",
    "./notes.json": "./notes.json",
    "./legacy.json": "./legacy.json",
    "./knowledge.json": "./knowledge.json",
    "./printer-models.json": "./printer-models.json",
    "./defaults": "./js/defaults.ts",
    "./easy": "./js/easy.ts",
    "./defaults.json": "./defaults.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
