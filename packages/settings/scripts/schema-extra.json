   "key": "smart_layer_max_height",
   "section": "process",
   "type": "float",
   "default": 0.3,
   "label": "sleipnir thickest layer",
   "help": "The thickest layer sleipnir may use. Keep it at most three quarters of the nozzle diameter unless the material's research says otherwise.",
   "mode": "simple",
   "unit": "mm",
   "min": 0.04,
   "max": 0.8
  },
