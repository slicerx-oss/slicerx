   "section": "process",
   "type": "float",
   "default": 0.15,
   "label": "sleipnir thinnest layer",
   "help": "The thinnest layer sleipnir may use. Keep it at least a quarter of the nozzle diameter unless the material's research says otherwise.",
   "mode": "simple",
   "unit": "mm",
   "min": 0.04,
   "max": 0.8
  },
