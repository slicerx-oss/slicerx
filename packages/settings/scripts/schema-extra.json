 "stage_overrides": {
  "enable_arc_fitting": "gcode",
  "top_surface_pattern": "infill",
  "bottom_surface_pattern": "infill"
 },
 "effects": {
  "layer_height": {
   "increase": "Thicker layers print faster and show more layer lines",
   "decrease": "Thinner layers print slower and look smoother"
  },
  "initial_layer_print_height": {
   "increase": "A thicker first layer hides bed unevenness but is harder to squish flat",
   "decrease": "A thinner first layer needs a level bed"
  },
  "wall_loops": {
   "increase": "More walls make the part stronger and add print time",
   "decrease": "Fewer walls save time and filament but weaken the part"
  },
  "top_shell_layers": {
   "increase": "Thicker top skin closes sparse infill gaps and adds time",
   "decrease": "Thinner top skin can show infill pattern through the top"
  },
  "bottom_shell_layers": {
   "increase": "Thicker bottom skin adds strength and time",
   "decrease": "Thinner bottom skin saves time"
  },
  "sparse_infill_density": {
   "increase": "Denser infill adds strength, filament and time",
   "decrease": "Sparser infill saves filament and time but weakens the part"
  },
  "line_width": {
   "increase": "Wider lines print faster and bond better",
   "decrease": "Narrower lines resolve finer detail"
  },
  "outer_wall_speed": {
   "increase": "A faster outer wall saves time and can show ringing",
   "decrease": "A slower outer wall gives a cleaner surface"
  },
  "inner_wall_speed": {
   "increase": "Faster inner walls save time",
   "decrease": "Slower inner walls improve bonding"
  },
  "sparse_infill_speed": {
   "increase": "Faster infill saves time, limited by the hotend flow",
   "decrease": "Slower infill costs time and helps little"
  },
  "top_surface_speed": {
   "increase": "Faster top surfaces save time and roughen the finish",
   "decrease": "Slower top surfaces look smoother"
  },
  "initial_layer_speed": {
   "increase": "A faster first layer saves time and risks poor adhesion",
   "decrease": "A slower first layer sticks better"
  },
  "travel_speed": {
   "increase": "Faster travel saves time and can cause vibration",
   "decrease": "Slower travel is quieter"
  },
  "default_acceleration": {
   "increase": "Higher acceleration saves time and increases ringing",
   "decrease": "Lower acceleration is quieter and cleaner"
  },
  "nozzle_temperature": {
   "increase": "A hotter nozzle flows more freely and bonds layers better, with more stringing",
   "decrease": "A cooler nozzle strings less and can under-extrude"
  },
  "hot_plate_temp": {
   "increase": "A hotter bed improves adhesion and can warp the first layers upward if too hot",
   "decrease": "A cooler bed lowers adhesion"
  },
  "textured_plate_temp": {
   "increase": "A hotter textured plate improves adhesion",
   "decrease": "A cooler textured plate lowers adhesion"
  },
  "cool_plate_temp": {
   "increase": "A hotter cool plate improves adhesion",
   "decrease": "A cooler cool plate lowers adhesion"
  },
  "eng_plate_temp": {
   "increase": "A hotter engineering plate improves adhesion and limits warping",
   "decrease": "A cooler engineering plate raises warping risk"
  },
  "chamber_temperature": {
   "increase": "A warmer chamber reduces warping on ABS and similar materials",
   "decrease": "A cooler chamber suits PLA"
  },
  "fan_min_speed": {
   "increase": "More part cooling improves overhangs and bridges and can weaken layer bonding",
   "decrease": "Less part cooling improves layer bonding"
  },
  "fan_max_speed": {
   "increase": "More part cooling improves small features and bridges",
   "decrease": "Less part cooling improves layer bonding"
  },
  "overhang_fan_speed": {
   "increase": "More fan on overhangs improves them",
   "decrease": "Less fan on overhangs can curl them"
  },
  "close_fan_the_first_x_layers": {
   "increase": "The fan stays off longer, which helps adhesion",
   "decrease": "The fan starts sooner, which cools the first layers"
  },
  "slow_down_layer_time": {
   "increase": "Small layers slow down more to cool",
   "decrease": "Small layers slow down less"
  },
  "retraction_length": {
   "increase": "Longer retraction reduces stringing and risks clogs",
   "decrease": "Shorter retraction can leave strings"
  },
  "retraction_speed": {
   "increase": "Faster retraction reduces stringing and can grind the filament",
   "decrease": "Slower retraction can ooze"
  },
  "z_hop": {
   "increase": "More lift avoids scarring on travel and slows printing",
   "decrease": "No lift is faster and can scar top surfaces"
  },
  "pressure_advance": {
   "increase": "Higher pressure advance sharpens corners and can gap them if too high",
   "decrease": "Lower pressure advance rounds and bulges corners"
  },
  "filament_flow_ratio": {
   "increase": "More flow fills gaps and can over-extrude",
   "decrease": "Less flow prevents blobs and can under-extrude"
  },
  "filament_max_volumetric_speed": {
   "increase": "A higher limit allows faster printing while the hotend keeps up",
   "decrease": "A lower limit slows fast features to protect extrusion"
  },
  "enable_support": {
   "increase": "Supports are added under overhangs",
   "decrease": "Overhangs print without support"
  },
  "support_threshold_angle": {
   "increase": "Support is added for more gentle overhangs",
   "decrease": "Support is limited to steeper overhangs"
  },
  "support_top_z_distance": {
   "increase": "Support separates more easily and leaves a rougher underside",
   "decrease": "Support bonds tighter and leaves a smoother underside"
  },
  "brim_width": {
   "increase": "A wider brim holds the part better and costs more time",
   "decrease": "A narrower brim frees more bed space"
  },
  "skirt_loops": {
   "increase": "More skirt loops prime the nozzle longer",
   "decrease": "No skirt skips priming"
  },
  "seam_position": {
   "increase": "Changes where layer starts and ends are placed",
   "decrease": "Changes where layer starts and ends are placed"
  },
  "ironing_type": {
   "increase": "Ironing smooths chosen top surfaces and adds time",
   "decrease": "Without ironing top surfaces print faster and rougher"
  },
  "enable_prime_tower": {
   "increase": "A prime tower cleans the nozzle between colors and uses more filament",
   "decrease": "Without a prime tower colors may bleed"
  },
  "spiral_mode": {
   "increase": "Vase mode prints one continuous outer wall with no infill",
   "decrease": "Normal layered printing"
  },
  "reduce_crossing_wall": {
   "increase": "Travel detours around walls to cut stringing and adds time",
   "decrease": "Travel goes straight and can string"
  },
  "fuzzy_skin": {
   "increase": "Fuzzy skin roughens the outer wall for grip and hides layer lines",
   "decrease": "Smooth outer walls"
  },
  "xy_hole_compensation": {
   "increase": "Holes print larger",
   "decrease": "Holes print smaller"
  },
  "xy_contour_compensation": {
   "increase": "Outer contours print larger",
   "decrease": "Outer contours print smaller"
  },
  "elefant_foot_compensation": {
   "increase": "The first layer is pulled in more to counter elephant foot",
   "decrease": "The first layer flares out more"
  },
  "smart_layer": {
   "increase": "sleipnir changes layer heights along the part",
   "decrease": "One layer height throughout"
  },
  "smart_layer_min_height": {
   "increase": "Fine areas get thicker layers and less detail",
   "decrease": "Fine areas get thinner layers and print slower"
  },
  "smart_layer_max_height": {
   "increase": "Plain areas print faster and look coarser",
   "decrease": "Plain areas print slower and look smoother"
  },
  "smart_layer_smoothing": {
   "increase": "Layer height changes more gradually",
   "decrease": "Layer height follows the surface more closely"
  },
  "smart_layer_max_step_ratio": {
   "increase": "Layer height may jump more between layers",
   "decrease": "Layer height changes in smaller steps"
  }
 },
