   "key": "smart_layer_smoothing",
   "section": "process",
   "type": "percent",
   "default": 50,
   "label": "sleipnir smoothing",
   "help": "How strongly neighboring layer heights are blended. 0 follows the surface exactly, 100 gives the gentlest change.",
