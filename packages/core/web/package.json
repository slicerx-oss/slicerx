{
  "name": "@slicerx/slicer",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./parts-paint": "./src/parts-paint.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:wasm": "sh scripts/build-wasm.sh",
    "bench": "node ../bench/web-slice.mjs",
    "build": "sh scripts/build-wasm.sh && vite build -c vite.lib.config.mjs && cp pkg/sx_wasm.wasm dist/sx_wasm.wasm && node ../../../scripts/emit-types.mjs . index=src/index.ts",
    "prepack": "pnpm run build",
    "prepublishOnly": "node ../../../scripts/publish-guard.mjs"
  },
  "devDependencies": {
    "@slicerx/contracts": "workspace:*",
    "playwright": "1.63.0",
    "vite": "8.3.1"
  },
  "description": "SlicerX browser slicer: sx-core in a WASM worker pool",
  "license": "Apache-2.0",
  "homepage": "https://github.com/slicerx-oss/slicerx/tree/main/packages/core/web#readme",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-APACHE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/slicerx-oss/slicerx.git",
    "directory": "packages/core/web"
  },
  "keywords": [
    "3d-printing",
    "slicer",
    "gcode",
    "wasm",
    "3mf",
    "stl"
  ]
}
