{
  "name": "@slicerx/embed",
  "version": "0.1.0",
  "private": false,
  "description": "SlicerX pieces for other apps: the 3D viewport and the print settings panel as React components and as <sx-viewport> and <sx-settings-panel> custom elements",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/slicerx-oss/slicerx.git",
    "directory": "packages/embed"
  },
  "homepage": "https://github.com/slicerx-oss/slicerx/tree/main/packages/embed#readme",
  "keywords": [
    "3d-printing",
    "slicer",
    "react",
    "custom-elements",
    "web-components",
    "viewport",
    "settings"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./mesh": "./src/mesh.ts",
    "./sxlock": "./src/sxlock.ts"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-APACHE",
    "NOTICE",
    "AGENTS.md",
    "quickstart.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./mesh": {
        "types": "./dist/mesh.d.ts",
        "import": "./dist/mesh.js"
      },
      "./sxlock": {
        "types": "./dist/sxlock.d.ts",
        "import": "./dist/sxlock.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "dev": "vite demo --port 5191",
    "build": "vite build -c vite.lib.config.mjs && node ../../scripts/emit-types.mjs . index=src/index.ts mesh=src/mesh.ts sxlock=src/sxlock.ts --keep @slicerx/viewport",
    "build:demo": "vite build demo",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "pnpm run build && node ../../scripts/copy-integrator-docs.mjs .",
    "test": "vitest run"
  },
  "dependencies": {
    "@slicerx/viewport": "workspace:*",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@slicerx/contracts": "workspace:*",
    "@slicerx/pilot": "workspace:*",
    "@slicerx/settings": "workspace:*",
    "@slicerx/ui": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
