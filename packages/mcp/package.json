{
  "name": "@slicerx/mcp",
  "version": "0.1.0",
  "private": false,
  "description": "Model Context Protocol server for SlicerX: slicing, settings, knowledge, printer status and a job queue for AI tools (prints start only after the user confirms)",
  "license": "Apache-2.0 AND AGPL-3.0-or-later AND LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/slicerx-oss/slicerx.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/slicerx-oss/slicerx/tree/main/packages/mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "3d-printing",
    "slicer",
    "gcode"
  ],
  "type": "module",
  "bin": {
    "slicerx-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./agents": "./src/agents.ts",
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-APACHE",
    "NOTICE",
    "AGENTS.md",
    "quickstart.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./agents": {
        "types": "./dist/agents.d.ts",
        "import": "./dist/agents.js"
      },
      "./cli": "./dist/cli.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "node scripts/build.mjs && node ../../scripts/copy-integrator-docs.mjs ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@slicerx/connect": "workspace:*",
    "@slicerx/contracts": "workspace:*",
    "@slicerx/embed": "workspace:*",
    "@slicerx/fleet-sim": "workspace:*",
    "@slicerx/link-client": "workspace:*",
    "@slicerx/mock-printers": "workspace:*",
    "@slicerx/pilot": "workspace:*",
    "@slicerx/printer-catalog": "workspace:*",
    "@slicerx/settings": "workspace:*",
    "@slicerx/ui": "workspace:*",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
