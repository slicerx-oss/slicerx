{
  "name": "@slicerx/pair",
  "version": "0.2.7",
  "private": false,
  "description": "Pair a phone app with SlicerX: end-to-end sealed pairing and sessions over the LAN or the SlicerX relay, printer status, live camera, approval cards and push alerts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/slicerx-oss/slicerx.git",
    "directory": "packages/pair"
  },
  "homepage": "https://github.com/slicerx-oss/slicerx/tree/main/packages/pair#readme",
  "keywords": [
    "3d-printing",
    "slicer",
    "pairing",
    "react-native",
    "end-to-end-encryption"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host.ts",
    "./client": "./src/client.ts",
    "./relay": "./src/relay.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-APACHE",
    "NOTICE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./host": {
        "types": "./dist/host.d.ts",
        "import": "./dist/host.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "import": "./dist/client.js"
      },
      "./relay": {
        "types": "./dist/relay.d.ts",
        "import": "./dist/relay.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@slicerx/contracts": "workspace:*",
    "@slicerx/fleet-sim": "workspace:*",
    "@slicerx/link-client": "workspace:*",
    "@slicerx/mock-printers": "workspace:*",
    "@slicerx/pilot": "workspace:*",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "vitest": "5.0.2"
  }
}
