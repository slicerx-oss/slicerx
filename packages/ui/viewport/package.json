{
  "name": "@slicerx/viewport",
  "version": "0.2.7",
  "private": false,
  "description": "Framework-free three.js viewport for SlicerX: models on a printer bed, painting and modeling tools, and SXPV toolpath previews",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/slicerx-oss/slicerx.git",
    "directory": "packages/ui/viewport"
  },
  "homepage": "https://github.com/slicerx-oss/slicerx/tree/main/packages/ui/viewport#readme",
  "keywords": [
    "3d-printing",
    "slicer",
    "gcode",
    "three",
    "viewport",
    "toolpath"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./palette": "./src/palette.ts",
    "./summary": "./src/summary.ts",
    "./mesh-worker": "./src/mesh-worker.ts",
    "./edge-drag": "./src/edge-drag/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "THEMING.md",
    "CHANGELOG.md",
    "LICENSE-APACHE",
    "NOTICE"
  ],
  "peerDependencies": {
    "three": "^0.186.0",
    "@types/three": "^0.186.0"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./palette": {
        "types": "./dist/palette.d.ts",
        "import": "./dist/palette.js"
      },
      "./summary": {
        "types": "./dist/summary.d.ts",
        "import": "./dist/summary.js"
      },
      "./mesh-worker": {
        "types": "./dist/mesh-worker.d.ts",
        "import": "./dist/mesh-worker.js"
      },
      "./edge-drag": {
        "types": "./dist/edge-drag.d.ts",
        "import": "./dist/edge-drag.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "dev": "vite demo --port 5190",
    "build": "vite build -c vite.lib.config.mjs && node ../../../scripts/emit-types.mjs . index=src/index.ts palette=src/palette.ts summary=src/summary.ts mesh-worker=src/mesh-worker.ts edge-drag=src/edge-drag/index.ts",
    "build:demo": "vite build demo",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "pnpm run build",
    "prepublishOnly": "node ../../../scripts/publish-guard.mjs"
  },
  "devDependencies": {
    "@slicerx/contracts": "workspace:*",
    "@types/three": "0.186.0",
    "jsdom": "30.1.1",
    "playwright-core": "1.63.0",
    "three": "0.186.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
