+// Whether every edge of a shell but the degenerate ones is used once forward and once reversed: the shell is closed
+// and its faces agree on which side is out.
+static bool IsClosedCoherentShell (const TopoDS_Shape& shell)
+{
+    NCollection_DataMap<TopoDS_Shape, int, TopTools_ShapeMapHasher> uses;
+    for (TopExp_Explorer ex (shell, TopAbs_EDGE); ex.More (); ex.Next ()) {
+        const TopoDS_Edge& edge = TopoDS::Edge (ex.Current ());
+        TopAbs_Orientation orientation = edge.Orientation ();
+        if (BRep_Tool::Degenerated (edge) || (orientation != TopAbs_FORWARD && orientation != TopAbs_REVERSED)) {
+            continue;
+        }
+        int use = orientation == TopAbs_FORWARD ? 1 : 2;
+        int* seen = uses.ChangeSeek (edge);
+        if (seen == nullptr) {
+            uses.Bind (edge, use);
+        } else if ((*seen & use) != 0) {
+            return false;
+        } else {
+            *seen |= use;
+        }
+    }
+    if (uses.IsEmpty ()) {
+        return false;
+    }
+    for (NCollection_DataMap<TopoDS_Shape, int, TopTools_ShapeMapHasher>::Iterator it (uses); it.More (); it.Next ()) {
+        if (it.Value () != 3) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// Many CAD programs write IGES as trimmed surfaces with no solid. When the file has no solid and no shell, its faces
+// are sewn together with a tolerance scaled to the model (a ten thousandth of its box diagonal, at least 0.001 and
+// at most 0.1 in the document's unit, millimeters here). Each sewn shell that closes becomes a solid, marked so its
+// mesh says "sewn". The faces that do not close stay loose, one free shape per sewn group, so they read as before.
+// A group keeps a name when every face in it came from shapes of that one name. Nothing changes when no shell
+// closes or OpenCASCADE fails on the way.
+void ImporterXcaf::SewLooseFaces ()
+{
+    Handle (XCAFDoc_ShapeTool) tool = XCAFDoc_DocumentTool::ShapeTool (document->Main ());
+    TDF_LabelSequence labels;
+    tool->GetFreeShapes (labels);
+
+    std::vector<std::pair<TopoDS_Shape, TDF_Label>> faces;
+    Bnd_Box box;
+    for (TDF_LabelSequence::Iterator it (labels); it.More (); it.Next ()) {
+        TopoDS_Shape shape = tool->GetShape (it.Value ());
+        if (TopExp_Explorer (shape, TopAbs_SOLID).More () || TopExp_Explorer (shape, TopAbs_SHELL).More ()) {
+            return;
+        }
+        for (TopExp_Explorer ex (shape, TopAbs_FACE); ex.More (); ex.Next ()) {
+            faces.emplace_back (ex.Current (), it.Value ());
+            BRepBndLib::Add (ex.Current (), box);
+        }
+    }
+    if (faces.size () < 2 || box.IsVoid ()) {
+        return;
+    }
+
+    std::vector<TopoDS_Shape> solids;
+    std::vector<TopoDS_Shape> open;
+    NCollection_DataMap<TopoDS_Shape, TDF_Label, TopTools_ShapeMapHasher> faceLabels;
+    try {
+        double tolerance = std::min (std::max (std::sqrt (box.SquareExtent ()) * 1.0e-4, 1.0e-3), 0.1);
+        BRepBuilderAPI_Sewing sewing (tolerance);
+        for (const auto& face : faces) {
+            sewing.Add (face.first);
+        }
+        sewing.Perform ();
+        const TopoDS_Shape& sewn = sewing.SewedShape ();
+        if (sewn.IsNull ()) {
+            return;
+        }
+        for (const auto& face : faces) {
+            const TopoDS_Shape& now = sewing.IsModified (face.first) ? sewing.Modified (face.first) : face.first;
+            if (!faceLabels.IsBound (now)) {
+                faceLabels.Bind (now, face.second);
+            }
+        }
+
+        BRep_Builder builder;
+        for (TopExp_Explorer ex (sewn, TopAbs_SHELL); ex.More (); ex.Next ()) {
+            const TopoDS_Shell& shell = TopoDS::Shell (ex.Current ());
+            if (IsClosedCoherentShell (shell)) {
+                BRepBuilderAPI_MakeSolid makeSolid (shell);
+                if (makeSolid.IsDone ()) {
+                    TopoDS_Solid solid = makeSolid.Solid ();
+                    if (BRepLib::OrientClosedSolid (solid)) {
+                        solids.push_back (solid);
+                        continue;
+                    }
+                }
+            }
+            TopoDS_Compound group;
+            builder.MakeCompound (group);
+            for (TopExp_Explorer faceEx (shell, TopAbs_FACE); faceEx.More (); faceEx.Next ()) {
+                builder.Add (group, faceEx.Current ());
+            }
+            open.push_back (group);
+        }
+        for (TopExp_Explorer ex (sewn, TopAbs_FACE, TopAbs_SHELL); ex.More (); ex.Next ()) {
+            open.push_back (ex.Current ());
+        }
+    } catch (const Standard_Failure&) {
+        return;
+    }
+    if (solids.empty ()) {
+        return;
+    }
+
+    auto groupName = [&] (const TopoDS_Shape& group, TCollection_ExtendedString& name) {
+        bool first = true;
+        std::string shared;
+        for (TopExp_Explorer ex (group, TopAbs_FACE); ex.More (); ex.Next ()) {
+            const TDF_Label* label = faceLabels.Seek (ex.Current ());
+            std::string faceName = label != nullptr ? GetLabelName (*label, tool) : std::string ();
+            if (first) {
+                shared = faceName;
+                first = false;
+            } else if (faceName != shared) {
+                return false;
+            }
+        }
+        if (shared.empty ()) {
+            return false;
+        }
+        name = TCollection_ExtendedString (shared.c_str (), Standard_True);
+        return true;
+    };
+    struct Added {
+        TopoDS_Shape shape;
+        bool sewnSolid;
+        bool named;
+        TCollection_ExtendedString name;
+    };
+    std::vector<Added> added;
+    for (const TopoDS_Shape& solid : solids) {
+        added.push_back ({ solid, true, false, TCollection_ExtendedString () });
+    }
+    for (const TopoDS_Shape& group : open) {
+        added.push_back ({ group, false, false, TCollection_ExtendedString () });
+    }
+    // Names come from the shapes the faces were read into, so they are read before those go.
+    for (Added& shape : added) {
+        shape.named = groupName (shape.shape, shape.name);
+    }
+    for (TDF_LabelSequence::Iterator it (labels); it.More (); it.Next ()) {
+        tool->RemoveShape (it.Value (), Standard_True);
+    }
+    for (const Added& shape : added) {
+        TDF_Label label = tool->AddShape (shape.shape, Standard_False, Standard_False);
+        if (shape.named) {
+            TDataStd_Name::Set (label, shape.name);
+        }
+        if (shape.sewnSolid) {
+            TDataStd_UAttribute::Set (label, SewnSolidGuid ());
+        }
+    }
+}
